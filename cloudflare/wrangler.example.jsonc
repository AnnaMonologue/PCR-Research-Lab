{
  "name": "pcr-research-lab-sandbox",
  "compatibility_date": "2026-10-09",
  "main": "./src/worker.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "AI_PROVIDER": "mock",
    "ENVIRONMENT": "sandbox",
    "REAL_PARTICIPANT_COLLECTION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pcr-research-lab-sandbox",
      "database_id": "REPLACE_WITH_YOUR_OWN_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}